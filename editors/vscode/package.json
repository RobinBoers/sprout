{
  "name": "sprout",
  "displayName": "Sprout",
  "version": "0.1.0",
  "description": "Companion extension for Sprout, the cute terminal agent.",
  "repository": {
    "type": "git",
    "url": "git+https://git.dupunkto.org/axcelott/sprout.git"
  },
  "bugs": {
    "url": "https://bugs.dupunkto.org/axcelott/sprout"
  },
  "author": "Robijntje",
  "publisher": "RobinBoers",
  "license": "Unlicense",
  "categories": [
    "Other"
  ],
  "keywords": [
    "agent",
    "cli",
    "terminal"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/entry.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
